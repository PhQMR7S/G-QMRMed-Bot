# Application
APP_ENV=development
APP_NAME=GQMRMed
APP_VERSION=0.1.0
SERVICE_ROLE=engine
LOG_LEVEL=INFO

# Telegram (added when Bot phase begins)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Database — Supabase PostgreSQL
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres

# Redis / job queue — Render Key Value
REDIS_URL=redis://USER:PASSWORD@HOST:6379

# Storage
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=gqmrmed
S3_REGION=

# Medical research / synthesis
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5.6-luna
RESEARCH_PROVIDER=pubmed
RESEARCH_API_KEY=
RESEARCH_EMAIL=

# Image generation / ComfyUI
IMAGE_PROVIDER=comfyui
COMFYUI_BASE_URL=http://comfyui:8188
COMFYUI_WORKFLOW_ID=
COMFYUI_MODEL=FLUX.2 Klein 4B
COMFYUI_TIMEOUT_SECONDS=180
COMFYUI_POLL_INTERVAL_SECONDS=1
COMFYUI_MAX_POLL_SECONDS=180
IMAGE_WIDTH=1080
IMAGE_HEIGHT=1920

# Admin (added when Admin phase begins)
ADMIN_SECRET=
