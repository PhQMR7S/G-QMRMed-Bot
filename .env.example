# Application
APP_ENV=development
APP_NAME=GQMRMed
APP_VERSION=0.1.0
SERVICE_ROLE=engine
LOG_LEVEL=INFO

# Telegram (added when Bot phase begins)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Database — Supabase PostgreSQL
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres

# Redis / job queue — Render Key Value
REDIS_URL=redis://USER:PASSWORD@HOST:6379

# Storage
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=gqmrmed
S3_REGION=

# AI — deterministic multi-provider routing
# Order is highest priority first. Local Ollama has no per-token API charge.
AI_PROVIDER_ORDER=ollama,openai_compatible,openai
AI_PROVIDER=ollama

# OpenAI Responses API (quality fallback; keep secret out of Git)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5.6-luna

# Any OpenAI-compatible gateway/provider (optional free-tier or paid provider)
AI_COMPATIBLE_API_KEY=
AI_COMPATIBLE_BASE_URL=
AI_COMPATIBLE_MODEL=

# Local Ollama (optional; requires a machine/container with enough compute)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=180

# Medical research
RESEARCH_PROVIDER=pubmed
RESEARCH_API_KEY=
RESEARCH_EMAIL=

# Image generation / ComfyUI
IMAGE_PROVIDER=comfyui
COMFYUI_BASE_URL=http://comfyui:8188
COMFYUI_WORKFLOW_ID=
COMFYUI_MODEL=FLUX.2 Klein 4B
COMFYUI_TIMEOUT_SECONDS=180
COMFYUI_POLL_INTERVAL_SECONDS=1
COMFYUI_MAX_POLL_SECONDS=180
IMAGE_WIDTH=1080
IMAGE_HEIGHT=1920

# Admin (added when Admin phase begins)
ADMIN_SECRET=
