# Application
APP_ENV=development
APP_NAME=GQMRMed
APP_VERSION=0.1.0
SERVICE_ROLE=api
LOG_LEVEL=INFO

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Database
DATABASE_URL=postgresql+asyncpg://gqmrmed:gqmrmed@postgres:5432/gqmrmed

# Redis
REDIS_URL=redis://redis:6379/0

# Storage
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=gqmrmed
S3_REGION=

# Medical research / synthesis
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5.6-luna
RESEARCH_PROVIDER=pubmed
RESEARCH_API_KEY=
RESEARCH_EMAIL=

# Image generation / ComfyUI
COMFYUI_BASE_URL=http://comfyui:8188

# Admin
ADMIN_SECRET=
