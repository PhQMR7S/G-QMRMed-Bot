# Application
APP_ENV=development
APP_NAME=GQMRMed
APP_VERSION=0.1.0
# Use api, bot, or worker for the dedicated service container.
SERVICE_ROLE=bot
LOG_LEVEL=INFO

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Database
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres

# Redis / job queue
REDIS_URL=redis://USER:PASSWORD@HOST:6379

# Storage
# Leave S3 variables empty when using Google Drive.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=gqmrmed
S3_REGION=
RESULT_STORAGE_DIR=/data/results
# Google Drive: service-account JSON and a folder shared with that service account.
# Keep credentials out of Git; provide them only through the production environment.
GOOGLE_DRIVE_CREDENTIALS_JSON=
GOOGLE_DRIVE_FOLDER_ID=

# AI — deterministic multi-provider routing
AI_PROVIDER_ORDER=ollama,openrouter_free,groq_free,openai_compatible,openai
AI_PROVIDER=ollama
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5.6-luna
AI_COMPATIBLE_API_KEY=
AI_COMPATIBLE_BASE_URL=
AI_COMPATIBLE_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT_SECONDS=120
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=120
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=180

# Medical research
RESEARCH_PROVIDER=pubmed
RESEARCH_API_KEY=
RESEARCH_EMAIL=

# Image generation / ComfyUI
COMFYUI_BASE_URL=http://comfyui:8188
# Paste the ComfyUI API-format workflow JSON here. Keep model/checkpoint names in the workflow.
COMFYUI_WORKFLOW_JSON=
COMFYUI_TIMEOUT_SECONDS=180
IMAGE_WIDTH=1080
IMAGE_HEIGHT=1920

# Admin
ADMIN_SECRET=
