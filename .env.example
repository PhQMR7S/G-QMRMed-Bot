# Application
APP_ENV=development
APP_NAME=GQMRMed
APP_VERSION=0.1.0
SERVICE_ROLE=bot
RUN_WORKER_IN_API=false
LOG_LEVEL=INFO

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Database
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres

# Redis / job queue
REDIS_URL=redis://USER:PASSWORD@HOST:6379

# Storage
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=gqmrmed
S3_REGION=
RESULT_STORAGE_DIR=/data/results

# AI — deterministic multi-provider routing
AI_PROVIDER_ORDER=ollama,openrouter_free,groq_free,huggingface_free,openai_compatible,openai
AI_PROVIDER=
AI_ALLOW_PAID=false
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5.6-luna
AI_COMPATIBLE_API_KEY=
AI_COMPATIBLE_BASE_URL=
AI_COMPATIBLE_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
HUGGINGFACE_TOKEN=
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
HUGGINGFACE_TEXT_MODEL=openai/gpt-oss-120b:fastest
HUGGINGFACE_IMAGE_MODEL=black-forest-labs/FLUX.1-dev
HUGGINGFACE_IMAGE_PROVIDER=auto
HUGGINGFACE_TIMEOUT_SECONDS=180
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=180

# Gemini — grounded medical research only
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_TIMEOUT_SECONDS=180

# Optional legacy image providers (not selected by default)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_IMAGE_MODEL=qwen-image-3.0-pro
NARAROUTER_API_KEY=
NARAROUTER_BASE_URL=https://router.bynara.id/v1
NARAROUTER_MODEL=agnes-2.5-flash

# GQMRMed reference-driven infographic pipeline
IMAGE_PROVIDER_ORDER=openai,procedural
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_TIMEOUT_SECONDS=180
IMAGE_GENERATION_TIMEOUT_SECONDS=180

# Medical research
RESEARCH_PROVIDER=gemini_grounded,pubmed
RESEARCH_API_KEY=
RESEARCH_EMAIL=

# Optional ComfyUI fallback
COMFYUI_BASE_URL=http://comfyui:8188
COMFYUI_WORKFLOW_JSON=
COMFYUI_TIMEOUT_SECONDS=180
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1536

# Admin
ADMIN_SECRET=
