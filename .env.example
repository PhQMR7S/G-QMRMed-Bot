# Application
APP_ENV=development
APP_NAME=GQMRMed
APP_VERSION=0.1.0
SERVICE_ROLE=bot
RUN_WORKER_IN_API=false
LOG_LEVEL=INFO

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Database
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres

# Redis / job queue
REDIS_URL=redis://USER:PASSWORD@HOST:6379

# Storage
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=gqmrmed
S3_REGION=
RESULT_STORAGE_DIR=/data/results

# AI — deterministic multi-provider routing
AI_PROVIDER_ORDER=ollama,openrouter_free,groq_free,huggingface_free,openai_compatible,openai
AI_PROVIDER=
AI_ALLOW_PAID=false
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5.6-luna
AI_COMPATIBLE_API_KEY=
AI_COMPATIBLE_BASE_URL=
AI_COMPATIBLE_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
HUGGINGFACE_TOKEN=
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
HUGGINGFACE_TEXT_MODEL=openai/gpt-oss-120b:fastest
HUGGINGFACE_IMAGE_MODEL=black-forest-labs/FLUX.1-dev
HUGGINGFACE_IMAGE_PROVIDER=auto
HUGGINGFACE_TIMEOUT_SECONDS=180
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=180

# Medical research
RESEARCH_PROVIDER=pubmed
RESEARCH_API_KEY=
RESEARCH_EMAIL=

# Image generation / ComfyUI fallback
COMFYUI_BASE_URL=http://comfyui:8188
COMFYUI_WORKFLOW_JSON=
COMFYUI_TIMEOUT_SECONDS=180
IMAGE_WIDTH=1080
IMAGE_HEIGHT=1920

# Admin
ADMIN_SECRET=
